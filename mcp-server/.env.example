# Copy to .env for local experiments. All of these are optional.
# The production URL https://wingxai.gallery/mcp is NOT live.

# Listening address. Vercel sets PORT itself.
PORT=8787
HOST=0.0.0.0

# Requests per minute per IP. Unset means 60. 0 disables the limiter.
WINGXAI_RATE_LIMIT_PER_MIN=60

# Gate is off unless this is true, 1, yes, or on.
WINGXAI_API_KEY_REQUIRED=false
WINGXAI_API_KEY=

# Absolute links in tool payloads. Default is the intended domain, which is not pointed yet.
# Set this to a Vercel preview origin when you need those links to resolve.
WINGXAI_PUBLIC_ORIGIN=https://wingxai.gallery
